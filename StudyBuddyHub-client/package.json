{
  "name": "studybuddy-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "playwright test",
    "prepare:netlify": "npm run build && node scripts/prepare-netlify.mjs",
    "format": "prettier --write src scripts tests *.js *.cjs *.html",
    "media:upload": "node scripts/upload-cloudinary.mjs",
    "media:check": "node scripts/upload-cloudinary.mjs --dry-run"
  },
  "dependencies": {
    "@firebase/app": "^0.16.5",
    "@firebase/auth": "^1.13.9",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.8"
  }
}
